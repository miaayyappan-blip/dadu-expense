# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dadu_expense

# ── Security — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-32-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI — Only Gemini is required (free tier works fine) ───────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# OpenAI is OPTIONAL — leave blank if you don't have billing set up
# Voice transcription will use Gemini instead (works just as well)
OPENAI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
